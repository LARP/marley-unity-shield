# Unity Autogenerated Code Analysis Rules
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# OS Generated
.DS_Store
Thumbs.db
desktop.ini

# Python virtual environment & caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
